# Copy this file to ".env" and fill in real values.
# ".env" itself is git-ignored and must NEVER be committed or pushed.

# MongoDB Atlas connection string (Person 4 sets this up)
# Get it from: Atlas dashboard -> Database -> Connect -> Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/trello_clone?retryWrites=true&w=majority

# Name of the database inside the cluster
MONGO_DB_NAME=trello_clone

# Flask secret key - used to sign session cookies. Use any long random string.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-this-with-a-random-generated-string

# Set to "development" while building, "production" when deployed
FLASK_ENV=development
